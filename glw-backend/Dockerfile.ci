# CI 多阶段构建：在构建阶段完成 Maven 打包，运行镜像只保留 JRE 和 jar。
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY . .
# 仓库在 Windows 下开发，mvnw 可能是 CRLF；CI 直接用镜像内的 mvn。
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /build/target/glw-backend-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
