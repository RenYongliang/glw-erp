<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.glw.backend.mapper.InboundOrderItemAllocMapper">
    <resultMap id="BaseResultMap" type="com.glw.backend.model.entity.InboundOrderItemAlloc">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="inbound_order_id" property="inboundOrderId" jdbcType="BIGINT"/>
        <result column="inbound_order_item_id" property="inboundOrderItemId" jdbcType="BIGINT"/>
        <result column="purchase_order_id" property="purchaseOrderId" jdbcType="BIGINT"/>
        <result column="purchase_order_no" property="purchaseOrderNo" jdbcType="VARCHAR"/>
        <result column="purchase_order_item_id" property="purchaseOrderItemId" jdbcType="BIGINT"/>
        <result column="date_code" property="dateCode" jdbcType="VARCHAR"/>
        <result column="lot_code" property="lotCode" jdbcType="VARCHAR"/>
        <result column="allocated_quantity" property="allocatedQuantity" jdbcType="INTEGER"/>
        <result column="unit_price" property="unitPrice" jdbcType="DECIMAL"/>
        <result column="tax_included" property="taxIncluded" javaType="com.glw.backend.model.enums.TaxIncluded" jdbcType="TINYINT"/>
        <result column="tax_rate" property="taxRate" jdbcType="INTEGER"/>
        <result column="amount" property="amount" jdbcType="DECIMAL"/>
        <result column="currency" property="currency" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="created_by" property="createdBy" jdbcType="BIGINT"/>
        <result column="updated_by" property="updatedBy" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `inbound_order_id`, `inbound_order_item_id`, `purchase_order_id`, `purchase_order_no`, `purchase_order_item_id`, `date_code`, `lot_code`, `allocated_quantity`, `unit_price`, `tax_included`, `tax_rate`, `amount`, `currency`, `created_at`, `updated_at`, `created_by`, `updated_by`
    </sql>

    <resultMap id="ReceivedQuantityMap" type="com.glw.backend.mapper.InboundOrderItemAllocMapper$ReceivedQuantity">
        <constructor>
            <arg column="purchase_order_item_id" javaType="java.lang.Long"/>
            <arg column="quantity" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <select id="sumCompletedByPurchaseOrderIds" resultMap="ReceivedQuantityMap">
        SELECT alloc.purchase_order_item_id, SUM(alloc.allocated_quantity) AS quantity
        FROM inbound_order_item_alloc alloc
        INNER JOIN inbound_order receipt ON receipt.id = alloc.inbound_order_id
        WHERE receipt.status = 'COMPLETED'
          AND alloc.purchase_order_id IN
          <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
              #{orderId}
          </foreach>
        GROUP BY alloc.purchase_order_item_id
    </select>
</mapper>
