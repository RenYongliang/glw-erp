<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.glw.backend.mapper.PurchaseOrderMapper">
    <resultMap id="BaseResultMap" type="com.glw.backend.model.entity.PurchaseOrder">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="purchase_order_no" property="purchaseOrderNo" jdbcType="VARCHAR"/>
        <result column="order_time" property="orderTime" jdbcType="TIMESTAMP"/>
        <result column="supplier_id" property="supplierId" jdbcType="BIGINT"/>
        <result column="supplier_name" property="supplierName" jdbcType="VARCHAR"/>
        <result column="delivery_time" property="deliveryTime" jdbcType="TIMESTAMP"/>
        <result column="tax_included" property="taxIncluded" javaType="com.glw.backend.model.enums.TaxIncluded" jdbcType="INTEGER"/>
        <result column="order_status" property="orderStatus" javaType="com.glw.backend.model.enums.PurchaseOrderStatus" jdbcType="VARCHAR"/>
        <result column="receipt_status" property="receiptStatus" javaType="com.glw.backend.model.enums.PurchaseReceiptStatus" jdbcType="VARCHAR"/>
        <result column="payment_status" property="paymentStatus" javaType="com.glw.backend.model.enums.PurchasePaymentStatus" jdbcType="VARCHAR"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="version" property="version" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="created_by" property="createdBy" jdbcType="BIGINT"/>
        <result column="updated_by" property="updatedBy" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `purchase_order_no`, `order_time`, `supplier_id`, `supplier_name`, `delivery_time`, `tax_included`, `order_status`, `receipt_status`, `payment_status`, `remark`, `version`, `created_at`, `updated_at`, `created_by`, `updated_by`
    </sql>
    <select id="orderTotal" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(COALESCE(amount, unit_price * quantity)), 0)
        FROM purchase_order_item WHERE purchase_order_id=#{orderId}
    </select>
</mapper>
