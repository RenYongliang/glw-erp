<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.glw.backend.mapper.FinAuditMapper">
  <resultMap id="BaseResultMap" type="com.glw.backend.model.entity.FinAudit">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="entity_type" property="entityType" jdbcType="VARCHAR"/>
    <result column="entity_id" property="entityId" jdbcType="BIGINT"/>
    <result column="action" property="action" jdbcType="VARCHAR"/>
    <result column="actor_id" property="actorId" jdbcType="BIGINT"/>
    <result column="detail" property="detail" jdbcType="VARCHAR"/>
    <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
  </resultMap>
  <sql id="Base_Column_List">id, entity_type, entity_id, action, actor_id, detail, created_at</sql>
  <insert id="audit">
    INSERT INTO fin_audit (entity_type,entity_id,action,actor_id,detail) VALUES (#{type},#{id},#{action},#{actor},#{detail})
  </insert>
</mapper>
