<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.glw.backend.mapper.OutboundOrderItemAllocMapper">
    <resultMap id="BaseResultMap" type="com.glw.backend.model.entity.OutboundOrderItemAlloc">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="outbound_order_id" property="outboundOrderId" jdbcType="BIGINT"/>
        <result column="outbound_order_item_id" property="outboundOrderItemId" jdbcType="BIGINT"/>
        <result column="sales_order_id" property="salesOrderId" jdbcType="BIGINT"/>
        <result column="sales_order_no" property="salesOrderNo" jdbcType="VARCHAR"/>
        <result column="customer_order_no" property="customerOrderNo" jdbcType="VARCHAR"/>
        <result column="sales_order_item_id" property="salesOrderItemId" jdbcType="BIGINT"/>
        <result column="allocated_quantity" property="allocatedQuantity" jdbcType="INTEGER"/>
        <result column="unit_price" property="unitPrice" jdbcType="DECIMAL"/>
        <result column="tax_included" property="taxIncluded" javaType="com.glw.backend.model.enums.TaxIncluded" jdbcType="TINYINT"/>
        <result column="tax_rate" property="taxRate" jdbcType="INTEGER"/>
        <result column="amount" property="amount" jdbcType="DECIMAL"/>
        <result column="currency" property="currency" jdbcType="VARCHAR"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
        <result column="created_by" property="createdBy" jdbcType="BIGINT"/>
        <result column="updated_by" property="updatedBy" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        `id`, `outbound_order_id`, `outbound_order_item_id`, `sales_order_id`, `sales_order_no`, `customer_order_no`, `sales_order_item_id`, `allocated_quantity`, `unit_price`, `tax_included`, `tax_rate`, `amount`, `currency`, `created_at`, `updated_at`, `created_by`, `updated_by`
    </sql>

    <resultMap id="ShippedQuantityMap" type="com.glw.backend.mapper.OutboundOrderItemAllocMapper$ShippedQuantity">
        <constructor>
            <arg column="sales_order_item_id" javaType="java.lang.Long"/>
            <arg column="quantity" javaType="java.lang.Long"/>
        </constructor>
    </resultMap>
    <select id="sumCompletedBySalesOrderIds" resultMap="ShippedQuantityMap">
        SELECT alloc.sales_order_item_id, SUM(alloc.allocated_quantity) AS quantity
        FROM outbound_order_item_alloc alloc
        INNER JOIN outbound_order shipment ON shipment.id = alloc.outbound_order_id
        WHERE shipment.status = 'COMPLETED'
          AND alloc.sales_order_id IN
          <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
              #{orderId}
          </foreach>
        GROUP BY alloc.sales_order_item_id
    </select>
</mapper>
